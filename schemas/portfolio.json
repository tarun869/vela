{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vela.energy/v1/portfolio.json",
  "title": "Portfolio",
  "description": "VPP portfolio grouping assets for co-optimization",
  "type": "object",
  "required": ["portfolio_id", "name", "asset_ids"],
  "properties": {
    "portfolio_id": { "type": "string" },
    "name": { "type": "string", "maxLength": 200 },
    "description": { "type": "string" },
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "markets": {
      "type": "array",
      "items": { "type": "string", "enum": ["caiso", "ercot", "pjm", "miso"] }
    },
    "optimization_objective": {
      "type": "string",
      "enum": ["max_revenue", "max_revenue_min_risk", "carbon_aware"],
      "default": "max_revenue"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_aggregate_power_mw": { "type": "number", "exclusiveMinimum": 0 },
        "min_aggregate_power_mw": { "type": "number", "minimum": 0 },
        "grid_import_limit_mw": { "type": "number" },
        "grid_export_limit_mw": { "type": "number" }
      }
    },
    "owner_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "active": { "type": "boolean", "default": true },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
