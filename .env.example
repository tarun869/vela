# Vela VPP Environment Configuration
# Copy to .env and fill in real values before running locally.
# Never commit .env to version control.

# ── LLM / Extraction (m39_extraction) ─────────────────────────────────────────
# Anthropic API key for Claude document extraction (PDF portfolio/contract parsing)
ANTHROPIC_API_KEY=

# ── Core ──────────────────────────────────────────────────────────────────────
VELA_ENV=development          # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vela:password@localhost:5432/vela
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300            # seconds
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth & security ───────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_SALT=change_me_to_another_strong_random_secret

# ── CAISO / OASIS ─────────────────────────────────────────────────────────────
CAISO_NODE=TH_NP15_GEN-APND
CAISO_OASIS_BASE_URL=http://oasis.caiso.com/oasisapi/SingleZip
CAISO_USERNAME=
CAISO_PASSWORD=

# ── ERCOT ─────────────────────────────────────────────────────────────────────
ERCOT_API_KEY=
ERCOT_API_BASE_URL=https://api.ercot.com/api/public-reports

# ── PJM ───────────────────────────────────────────────────────────────────────
PJM_API_KEY=
PJM_API_BASE_URL=https://api.pjm.com/api/v1

# ── AWS (for S3 data lake and Secrets Manager) ────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_DATA_LAKE_BUCKET=vela-data-lake
S3_PREFIX=prod/

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=vela-consumer
KAFKA_SECURITY_PROTOCOL=PLAINTEXT    # PLAINTEXT | SSL | SASL_SSL

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=vela-vpp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05         # 5% sampling rate

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
ALERT_EMAIL_FROM=alerts@vela.io
ALERT_EMAIL_TO=ops@vela.io
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=

# ── Optimizer ─────────────────────────────────────────────────────────────────
OPTIMIZER_HORIZON_HOURS=24
OPTIMIZER_INTERVAL_MINUTES=15
AUTO_SUBMIT_BIDS=false
MAX_CONSECUTIVE_ERRORS=5

# ── Dashboard ─────────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ── API server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
